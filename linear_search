#include <iostream>
using namespace std;

int main() {
    int arr[] = {10, 25, 40, 18, 99, 67};
    int n = 6;
    int key;

    cout << "Enter element to search: ";
    cin >> key;

    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            cout << "Element found at index " << i;
            return 0;
        }
    }

    cout << "Element not found";

    return 0;
}
