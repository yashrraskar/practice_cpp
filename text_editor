#include <iostream>
using namespace std;
#include <string>

class node{
   public:
   string data;
   node*next;

   node(){
       next = NULL;   
   }
};

node * head = NULL;

void addatend(){
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data;

   if (head==NULL){
       head = nn;
   } else {
       node * temp = head;
       while(temp->next != NULL){
           temp = temp->next;
       }
       temp->next=nn;
   }
}

void addatstart(){
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data;
 
   if (head==NULL){
       head=nn;
   } else {
       nn->next=head;
       head=nn;
   }
}

void addat(){
   int pos;
   cout << "Enter position :";
   cin >> pos ;

   if (pos == 1){
       addatstart();
       return;
   }
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data ;

   node *temp = head;
 
   for (int i = 1; i<pos-1 && temp != NULL ; i++){
       temp = temp->next;
   }

   if (temp == NULL){
       cout << "Invalid Position." << endl;
       delete nn;
       return;
   }

   nn -> next = temp -> next;
   temp -> next = nn;
}
void deleteatstart(){
   if (head == NULL){
       cout<<"Nothing to delete."<<endl;
       return;
   }
   node * temp = head;
   head = head -> next;
   delete temp;
}

void deleteatend(){
   if (head == NULL){
       cout<<"Nothing to delete."<<endl;
       return;
   }

   if (head -> next == NULL){
       delete head;
       head = NULL;
       return;
   }

   node * temp = head;
   while(temp->next->next != NULL){
       temp = temp -> next;
   }
   delete temp->next;
   temp -> next = NULL;
}

void deleteat() {

   if (head == NULL) {
       cout << "List is Empty!" << endl;
       return;
   }

   string val;
   cout << "Enter Text to delete: ";
   cin >> val;

   if (head->data == val) { //condition to delete head
       node* temp = head;
       head = head->next;
       delete temp;
       cout << "Node Deleted!" << endl;
       return;
   }

   node* temp = head;

   while (temp->next != NULL && temp->next->data != val) {
       temp = temp->next;
   }

   if (temp->next == NULL) {
       cout << "Text Not Found!" << endl;
       return;
   }

   node* del = temp->next;
   temp->next = del->next;
   delete del;

   cout << "Node Deleted!" << endl;
}

void reverse(){
   node * curr=head;
   node * prev=NULL;
   node * next=NULL;

   while(curr != NULL){
       next=curr->next;
       curr->next=prev;
       prev=curr;
       curr=next;
   }
   head=prev;
   cout << "List Reversed." << endl;
}

void search() {

   if (head == NULL) {
       cout << "List is Empty!" << endl;
       return;
   }

   string val;
   cout << "Enter Text to search: ";
   cin >> val;

   node* temp = head;
   int pos = 1;

   while (temp != NULL) {

       if (temp->data == val) {
           cout << "Found at Position " << pos << endl;
           return;
       }

       temp = temp->next;
       pos++;
   }

   cout << "Text Not Found!" << endl;
}

void display(){
   if (head == NULL){
       cout<<"Nothing to display."<<endl;
       return;
   }
   node * temp = head;
   while(temp != NULL){
       cout << temp->data << " "; 
       temp = temp -> next;
   }
   cout<<"."<<endl;
}
