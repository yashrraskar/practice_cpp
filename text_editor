#include <iostream>
using namespace std;
#include <string>

class node{
   public:
   string data;
   node*next;

   node(){
       next = NULL;   
   }
};

node * head = NULL;

void addatend(){
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data;

   if (head==NULL){
       head = nn;
   } else {
       node * temp = head;
       while(temp->next != NULL){
           temp = temp->next;
       }
       temp->next=nn;
   }
}

void addatstart(){
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data;
 
   if (head==NULL){
       head=nn;
   } else {
       nn->next=head;
       head=nn;
   }
}

void addat(){
   int pos;
   cout << "Enter position :";
   cin >> pos ;

   if (pos == 1){
       addatstart();
       return;
   }
   node * nn = new node;
   cout << "Enter Text :";
   cin >> nn->data ;

   node *temp = head;
 
   for (int i = 1; i<pos-1 && temp != NULL ; i++){
       temp = temp->next;
   }

   if (temp == NULL){
       cout << "Invalid Position." << endl;
       delete nn;
       return;
   }

   nn -> next = temp -> next;
   temp -> next = nn;
}
