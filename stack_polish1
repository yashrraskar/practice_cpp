#include<iostream>
#include<string>
using namespace std;

class node{
public:
   node *next;
   char data;

   node(char x){
       next = NULL;
       data = x;
   }
};

class stack{
private:
   node *top;

public:
   string infix, postfix, prefix;

   stack(){
       top = NULL;
   }

   void push(char x){
       node* nn = new node(x);
       nn->next = top;
       top = nn;
   }

   char pop(){
       if(top == NULL){
           return '\0';
       }

       node *temp = top;
       char x = temp->data;
       top = top->next;
       delete temp;
       return x;
   }

   char peak(){
       if(top == NULL){
           return '\0';
       }
       return top->data;
   }

   bool isnull(){
       return top == NULL;
   }

   bool opcheck(char x){
       if(x == '+' || x == '-' || x == '*' ||
          x == '/' || x == '^'){
           return true;
       }
       return false;
   }

   int precedence(char x){
       if(x == '^')
           return 3;

       if(x == '/' || x == '*')
           return 2;

       if(x == '+' || x == '-')
           return 1;

       return 0;
   }

   void getinfix(){
       cout << "Enter Infix Equation : ";
       cin >> infix;
   }

   void disp(){
       cout << "Stack : ";

       node *temp = top;

       while(temp != NULL){
           cout << temp->data;
           temp = temp->next;
       }
       cout << endl;
   }

   void infixtopostfix(){
       postfix = "";

       for(int i = 0; i < infix.length(); i++){
           char x = infix[i];

           if(!opcheck(x) && x != '(' && x != ')'){
               postfix += x;
           }

           else if(x == '('){
               push(x);
           }

           else if(x == ')'){
               while(!isnull() && peak() != '('){
                   postfix += pop();
               }

               if(!isnull() && peak() == '('){
                   pop();
               }
           }

           else{
               while(!isnull() &&
                     peak() != '(' &&
                     precedence(peak()) >= precedence(x)){

                   postfix += pop();
               }
               push(x);
           }
       }

       while(!isnull()){
           postfix += pop();
       }

       cout << "Postfix : " << postfix << endl;
   }

   void prefixtoinfix(){
       string rev = reverse(prefix);
       string s[100];
       int top = -1;
  
       for(int i = 0; i < rev.length(); i++){
           char x = rev[i];
  
           if(!opcheck(x)){
               top++;
               s[top] = x;
           }
  
           else{
               string a = s[top];
               top--;
  
               string b = s[top];
               top--;
  
               top++;
               s[top] = "(" + b + x + a + ")";
           }
       }
  
       infix = s[top];

       cout << "Infix : " << infix << endl;
   }

   void getprefix(){
       cout << "Enter Prefix Equation : ";
       cin >> prefix;
   };

   string reverse(string x){
       string rev = "";
       for(int i = x.length() - 1; i >= 0; i--){
           rev += x[i];
       }
  
       return rev;
   }

   void solinfix(){
       infixtopostfix();

       int s[100];
       int top = -1;

       for (int i = 0 ; i < postfix.length() ; i++ ){
           char x = postfix[i];

           if ( x >= '0' && x <= '9' ){
               top++;
                s[top] = x - '0';
           }
           else {
               int b = s[top--];
               int a = s[top--];

               if(x == '+')
               s[++top] = a + b;

               else if(x == '-')
                   s[++top] = a - b;

               else if(x == '*')
                   s[++top] = a * b;

               else if(x == '/')
                   s[++top] = a / b;
           }
       }
       cout << "Answer : " << s[top] << endl;
   }

   void solpostfix(){

       int s[100];
       int top = -1;
  
       for(int i = 0; i < postfix.length(); i++){
  
           char x = postfix[i];
  
           if(x >= '0' && x <= '9'){
               s[++top] = x - '0';
           }
  
           else{
               int b = s[top--];
               int a = s[top--];
  
               if(x == '+')
                   s[++top] = a + b;
  
               else if(x == '-')
                   s[++top] = a - b;
  
               else if(x == '*')
                   s[++top] = a * b;
  
               else if(x == '/')
                   s[++top] = a / b;
           }
       }
  
       cout << "Answer : " << s[top] << endl;
   }
  
   void solprefix(){

       int s[100];
       int top = -1;
  
       for(int i = prefix.length() - 1; i >= 0; i--){
  
           char x = prefix[i];
  
           if(x >= '0' && x <= '9'){
               s[++top] = x - '0';
           }
  
           else{
               int a = s[top--];
               int b = s[top--];
  
               if(x == '+')
                   s[++top] = a + b;
  
               else if(x == '-')
                   s[++top] = a - b;
  
               else if(x == '*')
                   s[++top] = a * b;
  
               else if(x == '/')
                   s[++top] = a / b;
           }
       }
  
       cout << "Answer : " << s[top] << endl;
   }

};

int main(){
   stack s1;
   int choice;

   do {
       cout << "Select operation :" << endl;
       cout << " 1. Infix to Postfix Equation." << endl;
       cout << " 2. Prefix to Infix Equation." << endl;
       cout << " 3. Solve Infix Equation." << endl;
       cout << " 4. Solve Prefix Equation." << endl;
       cout << " 5. Solve Postfix Equation." << endl;

       cout << "Enter choice : ";
       cin >> choice;

       switch(choice){

           case 1:
               s1.getinfix();
               s1.infixtopostfix();
               cout << endl;
               break;

           case 2:
               s1.getprefix();
               s1.prefixtoinfix();
               cout << endl;
               break;

           case 3:
               s1.getinfix();
               s1.solinfix();
               cout << endl;
               break;

           case 4:
               s1.getprefix();
               s1.solprefix();
               cout << endl;
               break;

           case 5:
               cout << "Enter Postfix Equation : ";
               cin >> s1.postfix;
               s1.solpostfix();
               cout << endl;
               break;
       }

   } while(choice != 0);

   return 0;
}
