#include <iostream>
using namespace std;

class node{
    public:
    int data;
    node*next;

    node(){
        next = NULL;    
    }
};

node * head = NULL;

void addatend(){
    node * nn = new node;
    cout << "Enter data :";
    cin >> nn->data;

    if (head==NULL){
        head = nn;
    } else {
        node * temp = head;
        while(temp->next != NULL){
            temp = temp->next;
        }
        temp->next=nn;
    }
}

void addatstart(){
    node * nn = new node;
    cout << "Enter data :";
    cin >> nn->data;
    
    if (head==NULL){
        head=nn;
    } else {
        nn->next=head;
        head=nn;
    }
}

void addat(){
    int pos;
    cout << "Enter position :";
    cin >> pos ;

    if (pos == 1){
        addatstart();
    }
    node * nn = new node;
    cout << "Enter data :";
    cin >> nn->data ;

    node *temp = head;
    
    for (int i = 1; i<pos-1 && temp != NULL ; i++){
        temp = temp->next;
    }

    if (temp == NULL){
        cout << "Invalid Position." << endl;
        delete nn;
        return;
    }

    nn -> next = temp -> next;
    temp -> next = nn;
}

void deleteatstart(){
    if (head == NULL){
        cout<<"Nothing to delete."<<endl;
        return;
    }
    node * temp = head;
    head = head -> next;
    delete temp;
}

void deleteatend(){
    if (head == NULL){
        cout<<"Nothing to delete."<<endl;
        return;
    }

    if (head -> next == NULL){
        delete head;
        head = NULL;
        return;
    }

    node * temp = head;
    while(temp->next->next != NULL){
        temp = temp -> next;
    }
    delete temp->next;
    temp -> next = NULL;
}


void reverse(){
    node * curr=head;
    node * prev=NULL;
    node * next=NULL;

    while(curr != NULL){
        next=curr->next;
        curr->next=prev;
        prev=curr;
        curr=next;
    }
    head=prev;
}

void sort(){
    if (head == NULL){
        cout << "Nothing to sort." << endl;
        return;
    }

    node *i;
    node *j;

    for (i = head ; i != NULL ; i = i -> next){
        for (j = i -> next ; j != NULL ; j = j -> next){
            if (i->data > j->data){
                int temp = i->data;
                i->data=j->data;
                j->data=temp;
            }
        }
    }
    cout << "Linked list sorted." << endl;
}

void display(){
    if (head == NULL){
        cout<<"Nothing to display."<<endl;
        return;
    }
    node * temp = head;
    while(temp != NULL){
        cout << temp->data << "->";  
        temp = temp -> next;
    }
    cout<<"NULL"<<endl;
}

