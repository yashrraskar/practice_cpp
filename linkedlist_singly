#include <iostream>
using namespace std;

class node{
    public:
    int data;
    node*next;

    node(){
        next = NULL;    
    }
};

node * head = NULL;

void addatend(){
    node * nn = new node;
    cout << "Enter data :";
    cin >> nn->data;

    if (head==NULL){
        head = nn;
    } else {
        node * temp = head;
        while(temp->next != NULL){
            temp = temp->next;
        }
        temp->next=nn;
    }
}

void display(){
    if (head == NULL){
        cout<<"NULL";
    }
    node * temp = head;
    while(temp != NULL){
        cout << temp->data << "->";
        temp = temp -> next;
    }
    cout<<"NULL"<<endl;
}

int main(){
    node n1;
    addatend();
    addatend();
    addatend();
    display();
    return 0;
}
