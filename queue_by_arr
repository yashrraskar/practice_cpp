#include <iostream>
using namespace std;

int arr[10];
int front = 0;
int rear = -1;

void addparty(int party) {

    if (rear == 9) {
        cout << "Waitlist is full" << endl;
        return;
    }
    
    rear++;
    arr[rear] = party;

    cout << "party "<< party  << " Added to waitlist" << endl;
}

void display() {
    if (front > rear) {
        cout << "Waitlist is Empty" << endl;
        return;
    }
    
    cout << "Waitlist : " ;
    for (int i = front; i <= rear; i++) {
        cout << arr[i] << " ";
    }

    cout << endl;
}

void seatparty(int party){
    if (rear == -1){
    cout << "Waitlist is Empty" << endl;
    return;
    }
    
    cout << party << " Entered the party" << endl;
    front++;
}

int main() {

    addparty(101);
    addparty(102);
    addparty(103);
    display();
    cout << endl;
    seatparty(101);
    seatparty(102);
    display();

    return 0;
}

