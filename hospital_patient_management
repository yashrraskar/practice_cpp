#include <iostream>
using namespace std;

class Node {
public:
    int patientID;
    string name;
    int age;
    string illness;
    Node* next;

    Node(int id, string n, int a, string i) {
        patientID = id;
        name = n;
        age = a;
        illness = i;
        next = NULL;
    }
};

class PatientQueue {
private:
    Node* head;

public:

    PatientQueue() {
        head = NULL;
    }

    // a. REGISTER NEW PATIENT
    void registerPatient() {

        int id, age;
        string name, illness;

        cout << "Enter Patient ID: ";
        cin >> id;

        cout << "Enter Patient Name: ";
        cin >> name;

        cout << "Enter Age: ";
        cin >> age;

        cout << "Enter Illness: ";
        cin >> illness;

        Node* nn = new Node(id, name, age, illness);

        if (head == NULL) {
            head = nn;
        }
        else {
            Node* temp = head;

            while (temp->next != NULL) {
                temp = temp->next;
            }

            temp->next = nn;
        }

        cout << "Patient registered successfully!\n";
    }


    // b. REMOVE PATIENT
    void removePatient() {

        if (head == NULL) {
            cout << "Queue is empty!\n";
            return;
        }

        int id;

        cout << "Enter Patient ID to remove: ";
        cin >> id;

        // If first patient
        if (head->patientID == id) {

            Node* temp = head;
            head = head->next;

            delete temp;

            cout << "Patient removed!\n";
            return;
        }

        Node* temp = head;

        while (temp->next != NULL &&
               temp->next->patientID != id) {

            temp = temp->next;
        }

        if (temp->next == NULL) {
            cout << "Patient not found!\n";
            return;
        }

        Node* del = temp->next;

        temp->next = del->next;

        delete del;

        cout << "Patient removed!\n";
    }


    // c. DISPLAY PATIENT QUEUE
    void display() {

        if (head == NULL) {
            cout << "Queue is empty!\n";
            return;
        }

        Node* temp = head;

        cout << "\n===== PATIENT QUEUE =====\n";

        while (temp != NULL) {

            cout << "Patient ID: " << temp->patientID << endl;
            cout << "Name: " << temp->name << endl;
            cout << "Age: " << temp->age << endl;
            cout << "Illness: " << temp->illness << endl;

            cout << "----------------------\n";

            temp = temp->next;
        }
    }


    // d. SEARCH PATIENT
    void searchPatient() {

        if (head == NULL) {
            cout << "Queue is empty!\n";
            return;
        }

        int id;

        cout << "Enter Patient ID to search: ";
        cin >> id;

        Node* temp = head;

        while (temp != NULL) {

            if (temp->patientID == id) {

                cout << "\nPatient Found!\n";
                cout << "Patient ID: " << temp->patientID << endl;
                cout << "Name: " << temp->name << endl;
                cout << "Age: " << temp->age << endl;
                cout << "Illness: " << temp->illness << endl;

                return;
            }

            temp = temp->next;
        }

        cout << "Patient not found!\n";
    }
};

int main() {

    PatientQueue p;

    int choice;

    do {

        cout << "\n===== HOSPITAL PATIENT QUEUE =====\n";
        cout << "1. Register Patient\n";
        cout << "2. Remove Patient\n";
        cout << "3. Display Queue\n";
        cout << "4. Search Patient\n";
        cout << "5. Exit\n";

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            p.registerPatient();
            break;

        case 2:
            p.removePatient();
            break;

        case 3:
            p.display();
            break;

        case 4:
            p.searchPatient();
            break;

        case 5:
            cout << "Exiting...\n";
            break;

        default:
            cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0;
}
